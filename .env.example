# Settings -> API Keys & Webhooks
PAYSTACK_PUBLIC_KEY=pk_live_df4ed1490fc1791297509d3fdc314f8dd3127feb
PAYSTACK_SECRET_KEY=sk_live_1101325720ad42791cee7cdf546896ef757a1beb

