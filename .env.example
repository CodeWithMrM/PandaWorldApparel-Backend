# ==============================
# Server
# ==============================
NODE_ENV=development
PORT=5000
# Base URL of THIS API (used to build PayFast return/cancel/notify URLs)
APP_URL=http://localhost:5000
# Base URL of your FRONTEND (used to redirect users after payment)
CLIENT_URL=http://localhost:3000

# ==============================
# Database (PostgreSQL)
# ==============================
DATABASE_URL="postgresql://neondb_owner:npg_szY2hDuLfWd6@ep-lingering-cell-abskbnd3-pooler.eu-west-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# ==============================
# Clerk Authentication
# https://dashboard.clerk.com -> your app -> API Keys
# ==============================
CLERK_SECRET_KEY=sk_test_dynnzC0UXXUegmMsP335Ip0NUjrByk1POvHgwm3PMe

CLERK_PUBLISHABLE_KEY=pk_test_Ymxlc3NlZC1wZWxpY2FuLTIzLmNsZXJrLmFjY291bnRzLmRldiQ
