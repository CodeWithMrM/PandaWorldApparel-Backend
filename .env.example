# ==============================
# Server
# ==============================
NODE_ENV=development
PORT=5000
# Base URL of THIS API (used to build PayFast return/cancel/notify URLs)
APP_URL=http://localhost:5000
# Base URL of your FRONTEND (used to redirect users after payment)
CLIENT_URL=http://localhost:3000

# ==============================
# Database (PostgreSQL)
# ==============================
DATABASE_URL="postgresql://neondb_owner:npg_szY2hDuLfWd6@ep-lingering-cell-abskbnd3-pooler.eu-west-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# ==============================
# Clerk Authentication
# https://dashboard.clerk.com -> your app -> API Keys
# ==============================
CLERK_SECRET_KEY=sk_test_dynnzC0UXXUegmMsP335Ip0NUjrByk1POvHgwm3PMe

CLERK_PUBLISHABLE_KEY=pk_test_Ymxlc3NlZC1wZWxpY2FuLTIzLmNsZXJrLmFjY291bnRzLmRldiQ
# Dashboard -> Webhooks -> create endpoint (POST {APP_URL}/api/webhooks/clerk)
# subscribed to: user.created, user.updated, user.deleted -> copy the signing secret
CLERK_WEBHOOK_SECRET=ep_3G4q4TxgeZRMsWj1u2iHwp0QSh5

# ==============================
# CORS
# ==============================
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3000

# ==============================
# File Uploads
# ==============================
# local | cloud  (cloud is a stub you can wire up to S3/Cloudinary/etc. later)
STORAGE_DRIVER=local
MAX_UPLOAD_SIZE_MB=5

# ==============================
# PayFast (South Africa)
# https://developers.payfast.co.za
# ==============================
# Use PayFast sandbox credentials while developing:
# https://sandbox.payfast.co.za
PAYFAST_MERCHANT_ID=10000100
PAYFAST_MERCHANT_KEY=46f0cd694581a
# Optional passphrase configured in your PayFast account (recommended, used to sign requests)
PAYFAST_PASSPHRASE=
# false while testing against sandbox.payfast.co.za, true in production
PAYFAST_SANDBOX=true
# process.payfast.co.za for live, sandbox.payfast.co.za for testing
PAYFAST_HOST=sandbox.payfast.co.za

# ==============================
# Rate Limiting
# ==============================
# General API limiter
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
