{
  "name": "ecommerce-backend",
  "version": "1.0.0",
  "description": "Production-ready e-commerce backend API (Node.js, Express, PostgreSQL, Prisma, JWT, PayFast)",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "prisma:generate": "prisma generate",
